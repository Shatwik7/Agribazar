<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AgriBazar Dashboard</title>
    <link rel="icon" type="image/x-icon" href="https://cdn5.vectorstock.com/i/1000x1000/81/69/white-bold-tree-icon-on-green-background-vector-1718169.jpg">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css" rel="stylesheet" crossorigin="anonymous">
    <link href="https://api.mapbox.com/mapbox-gl-js/v2.6.1/mapbox-gl.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">
    <style>
        body, html {
            font-family: 'Arial', sans-serif;
            background-color: #f0f2f5;
            margin: 0;
            padding: 0;
            height: 100%;
            overflow: hidden;
        }

        /* Sidebar Styling */
        .sidebar {
            background-color: #2c3e50;
            color: white;
            position: fixed;
            top: 0;
            left: 0;
            height: 100%;
            width: 250px;
            z-index: 1000;
            transition: width 0.3s ease;
        }

        .sidebar.collapsed {
            width: 80px;
        }

        .sidebar .nav-link {
            color: #b8c6d1;
            transition: background 0.3s, color 0.3s;
            padding: 12px 16px;
        }

        .sidebar .nav-link:hover,
        .sidebar .nav-link.active {
            background-color: #1abc9c;
            color: white;
        }

        .sidebar .nav-link i {
            margin-right: 8px;
        }

        /* Sidebar Toggle */
        .sidebar .toggle-btn {
            background-color: transparent;
            border: none;
            color: white;
            font-size: 20px;
            margin: 15px;
        }

        /* User Profile Dropdown Styling */
        .dropdown-menu-dark .dropdown-item {
            color: #dcdde1;
        }

        .dropdown-menu-dark .dropdown-item:hover {
            background-color: #1abc9c;
            color: white;
        }

        /* Main Content Styling */
        .content {
            margin-left: 250px; /* Offset for sidebar */
            padding: 20px;
            height: 100vh;
            overflow-y: auto;
            transition: margin-left 0.3s ease;
        }

        .content.collapsed {
            margin-left: 80px;
        }

        /* Header */
        h1 {
            color: #2d3436;
        }

        .description {
            font-size: 1.2rem;
            color: #636e72;
            text-align: center;
        }

        /* Footer (optional) */
        footer {
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            background-color: #2c3e50;
            color: white;
            padding: 10px;
            text-align: center;
        }

    </style>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
</head>
<body>
    <div class="sidebar">
        <div class="d-flex flex-column align-items-center align-items-sm-start px-3 pt-2">
            <div class="d-flex align-items-center justify-content-between">
                <a href="/" class="text-white text-decoration-none">
                    <i class="bi bi-box-arrow-in-left"></i>
                </a>
                <button class="toggle-btn me-2" onclick="toggleSidebar()">
                    <i class="bi bi-list"></i>
                </button>

            </div>
            <ul class="nav nav-pills flex-column mb-sm-auto mb-0 align-items-center align-items-sm-start" id="menu">
                <li>
                    <a href="/admin" class="nav-link px-0 align-middle">
                        <i class="fs-4 bi-speedometer2"></i> <span class="ms-1 d-none d-sm-inline">Dashboard</span>
                    </a>
                </li>
                <li>
                    <a href="/admin/report" class="nav-link px-0 align-middle">
                        <i class="fs-4 bi-table"></i> <span class="ms-1 d-none d-sm-inline">Report</span>
                    </a>
                </li>
                <li>
                    <a href="/admin/analytics" class="nav-link px-0 align-middle">
                        <i class="bi bi-graph-down"></i> <span class="ms-1 d-none d-sm-inline">Analytics</span>
                    </a>
                </li>
                <li>
                    <a href="/admin/users" class="nav-link px-0 align-middle">
                        <i class="fs-4 bi-people"></i> <span class="ms-1 d-none d-sm-inline">Users</span>
                    </a>
                </li>
            </ul>
            <hr>
            <div class="dropdown pb-4">
                <a href="#" class="d-flex align-items-center text-white text-decoration-none dropdown-toggle" id="dropdownUser1" data-bs-toggle="dropdown" aria-expanded="false">
                    <img src="https://github.com/mdo.png" alt="User" width="30" height="30" class="rounded-circle">
                    <span class="d-none d-sm-inline mx-1"><%=currentUser.user_name%></span>
                </a>
                <ul class="dropdown-menu dropdown-menu-dark text-small shadow">
                    <li><a class="dropdown-item" href="/user/<%=currentUser%>">Profile</a></li>
                    <li>
                        <hr class="dropdown-divider">
                    </li>
                    <li><a class="dropdown-item" href="/logout">Sign out</a></li>
                </ul>
            </div>
        </div>
    </div>

    <div class="content">
        <%-include('../partials/flash') %>
        <%-body%>
    </div>


</body>
<script>
    function toggleSidebar() {
        var sidebar = document.querySelector('.sidebar');
        var content = document.querySelector('.content');
        sidebar.classList.toggle('collapsed');
        content.classList.toggle('collapsed');
    }
    toggleSidebar()
</script>
</html>
